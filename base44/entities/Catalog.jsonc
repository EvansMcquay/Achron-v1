{
  "name": "Catalog",
  "type": "object",
  "properties": {
    "institution_id": {
      "type": "string",
      "description": "Reference to the Institution this catalog belongs to"
    },
    "catalog_year": {
      "type": "string",
      "description": "Academic catalog year e.g. 2026-2027. Versioned \u2014 requirements are tied to a specific catalog."
    },
    "source_url": {
      "type": "string",
      "description": "Official catalog URL this version was sourced from"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "verified",
        "pending",
        "rejected"
      ],
      "default": "pending"
    },
    "last_verified": {
      "type": "string",
      "format": "date"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "institution_id",
    "catalog_year",
    "verification_status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.verification_status": "verified"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}